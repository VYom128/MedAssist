# ---- Phase 0 (validated at startup) ----
NODE_ENV=development
# 5000 is taken by macOS AirPlay Receiver, so dev uses 5001
PORT=5001
# Must be a replica set from Phase 4 (transactions). A standalone mongod is fine for Phase 0.
MONGO_URI=mongodb://127.0.0.1:27017/med_assist
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
# Global API rate limit per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Later phases (not validated yet; uncomment when the phase needs them) ----
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=
# REFRESH_TOKEN_TTL_DAYS=7
