# ---- Validated at startup (src/config/env.ts) ----

# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port for the API (defaults to 5000; macOS AirPlay Receiver uses 5000, so dev uses 5001)
PORT=5001
# MongoDB connection string; must be a replica set from Phase 4 (transactions). Not needed for tests.
MONGO_URI=mongodb://127.0.0.1:27017/med_assist
# Frontend origin allowed by CORS and used in email links
CLIENT_URL=http://localhost:5173
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Global API rate-limit window in milliseconds (15 min)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window
RATE_LIMIT_MAX=300

# ---- Later phases (not validated yet; uncomment when the phase needs them) ----

# Secret for signing access tokens (random 64 chars)
# JWT_ACCESS_SECRET=
# Access token lifetime
# JWT_ACCESS_EXPIRES_IN=15m
# Secret for refresh tokens (random 64 chars)
# JWT_REFRESH_SECRET=
# Refresh token lifetime in days
# REFRESH_TOKEN_TTL_DAYS=7
# Secure flag on cookies (true in production)
# COOKIE_SECURE=false
# SameSite for cookies: lax (dev) / none (prod cross-site)
# COOKIE_SAMESITE=lax
# bcrypt cost factor
# BCRYPT_ROUNDS=12
# AI provider: anthropic | mock
# AI_PROVIDER=mock
# Anthropic API key (only when AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# Claude model id
# AI_MODEL=
# AI request timeout in milliseconds
# AI_TIMEOUT_MS=30000
# File storage driver: local | s3 | cloudinary
# STORAGE_DRIVER=local
# Upload directory for the local driver
# UPLOAD_DIR=./uploads
# Max upload size in MB
# MAX_UPLOAD_MB=10
# SMTP host
# SMTP_HOST=
# SMTP port
# SMTP_PORT=
# SMTP username
# SMTP_USER=
# SMTP password
# SMTP_PASS=
# From address for outgoing email
# MAIL_FROM=
# HMAC secret for the audit log hash chain
# AUDIT_HASH_SECRET=
