# ---- Validated at startup (src/config/env.ts) ----

# Runtime mode: development | test | production
NODE_ENV=development
# HTTP port for the API (defaults to 5000; macOS AirPlay Receiver uses 5000, so dev uses 5001)
PORT=5001
# MongoDB connection string; must be a replica set from Phase 4 (transactions). Not needed for tests.
MONGO_URI=mongodb://127.0.0.1:27017/med_assist
# Frontend origin allowed by CORS and used in email links (production: the deployed https:// URL)
CLIENT_URL=http://localhost:5173
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Global API rate-limit window in milliseconds (15 min)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window: per signed-in user, or per IP for anonymous requests
RATE_LIMIT_MAX=300
# Proxies in front of the API whose X-Forwarded-For hops are trusted for the client IP:
# 1 = one proxy (local tests); on Render, measured (D207): 3 = Render alone (edge + load
# balancer), 4 = Vercel /api rewrite -> Render. Check `client.ip` in /api/v1/health after a change.
TRUST_PROXY=1

# Secret for signing access tokens (random, at least 32 chars; e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Access token lifetime: number + s|m|h|d
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token (session) lifetime in days; sliding – each refresh extends it
REFRESH_TOKEN_TTL_DAYS=7
# Secure flag on the refresh cookie (must be true in production; needs HTTPS)
COOKIE_SECURE=false
# SameSite for the refresh cookie: lax (dev, same-site) / none (prod, cross-site; needs COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# bcrypt cost factor (4–15; defaults to 4 when NODE_ENV=test)
BCRYPT_ROUNDS=12
# HMAC secret for the audit log hash chain (random, at least 32 chars)
AUDIT_HASH_SECRET=change-me-to-another-random-string-of-32-chars
# Email transport: console (dev/test; prints recipient, subject and links to the log) | smtp (required in production)
EMAIL_TRANSPORT=console
# SMTP settings (host, port and MAIL_FROM required when EMAIL_TRANSPORT=smtp; user and password
# also required in production; e.g. Ethereal in dev)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# From address for outgoing email
# MAIL_FROM="MedAssist <no-reply@medassist.dev>"

# Queue board kiosk key (at least 24 random characters). The waiting-room screen opens
# /queue-board?key=<this>. Leave unset to switch the board off.
# KIOSK_KEY=

# Background jobs (appointment reminders and no-show marking, every 15 min in the clinic
# timezone): true to run them in this API process. Only one API instance should run jobs.
JOBS_ENABLED=false

# Seeding the hosted demo database: with NODE_ENV=production `npm run seed` refuses unless you pass
# `-- --demo` AND set this to true (demo data only – never on a real clinic's database)
ALLOW_DEMO_SEED=false

# AI features (spec §9). Provider: mock (deterministic output, no network – the dev default; the
# seed and tests always use it) | openai_compatible (any OpenAI-style chat-completions API, e.g.
# Groq or OpenRouter – switch by changing the variables below only). Production with mock refuses
# AI calls. Only demo data may be sent to an AI provider.
AI_PROVIDER=mock

# -- Groq (https://console.groq.com/keys) --
# Base URL of the chat-completions API (the server calls <AI_BASE_URL>/chat/completions)
AI_BASE_URL=https://api.groq.com/openai/v1
# API key – required when AI_PROVIDER=openai_compatible. Server only; never logged or sent to the client.
# AI_API_KEY=
# Main model, then the fallbacks (comma list, tried in order after a 429, 5xx, timeout or unusable output)
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# -- OpenRouter (https://openrouter.ai/keys) – use instead of the Groq block --
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# AI_FALLBACK_MODELS=qwen/qwen3-32b,openai/gpt-oss-20b

# Timeout of one provider call in ms (1000–120000)
AI_TIMEOUT_MS=30000
# Sampling temperature (0–2; low = more literal)
AI_TEMPERATURE=0.2
# Max output tokens per call (256–32000; reasoning models spend some before answering)
AI_MAX_TOKENS=4000
# AI calls per clinic day across the clinic, every attempt counted (cached explanations are free)
AI_DAILY_CALL_LIMIT=300

# File storage driver: local (development) | cloudinary (production – the host disk is wiped on
# every redeploy, so local is refused there). s3 is not available.
STORAGE_DRIVER=local
# Upload directory for the local driver (created on start, gitignored, never served statically;
# must be outside the client folder). Relative paths are resolved from the server folder.
UPLOAD_DIR=./uploads
# Max upload size in MB (1–50)
MAX_UPLOAD_MB=10

# Cloudinary (required when STORAGE_DRIVER=cloudinary; Console → Settings → API Keys). Files are
# private "authenticated" raw assets; the API streams them, the browser never gets a link.
# CLOUDINARY_CLOUD_NAME=<your-cloud-name>
# CLOUDINARY_API_KEY=<your-api-key>
# CLOUDINARY_API_SECRET=<your-api-secret>
# Folder for every stored file (default medassist)
# CLOUDINARY_FOLDER=medassist

# Set by Render on every deploy (shown by /api/v1/health); leave unset locally
# RENDER_GIT_COMMIT=
